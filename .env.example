# Salin ke .env.local untuk dicoba di laptop, atau isi di dashboard hosting (Render > Environment).
# JANGAN pernah meng-commit file berisi nilai asli.

# Password untuk masuk. Kalau kosong, tidak ada login (cocok untuk laptop sendiri).
APP_PASSWORD=

# Database Upstash Redis (gratis) untuk menyimpan favorit, Tonton nanti, dan posisi terakhir.
# Kalau kosong, data disimpan di folder data/ (cocok untuk laptop sendiri).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
